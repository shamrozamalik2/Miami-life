# Live Google reviews (optional). Without these, the site shows the verbatim review excerpts in src/data/company.js.
# Browser key: restrict it by HTTP referrer to your domain, and to "Maps JavaScript API" + "Places API (New)".
VITE_GOOGLE_MAPS_API_KEY=
# Optional: the Google Place ID (find it with Google's Place ID Finder). If empty, the business is found by name.
VITE_GOOGLE_PLACE_ID=
